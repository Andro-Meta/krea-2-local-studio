# Krea 2 Studio configuration
# Copy to .env and fill in values

# Hugging Face token (optional; faster downloads, higher rate limits, gated models)
# Create one at https://huggingface.co/settings/tokens (read access is enough).
HF_TOKEN=

# CivitAI API token (optional; required for some CivitAI LoRA downloads and
# faster download speeds). Create one at https://civitai.com/user/account
CIVITAI_TOKEN=

# ComfyUI is the generation engine and is REQUIRED for image generation.
# run.bat starts (or reuses) a local ComfyUI automatically. To use your own
# engine instead - a different port or another machine - set KREA_COMFY_URL;
# non-local URLs disable the automatic local startup.
#KREA_COMFY_URL=http://127.0.0.1:8188

# ComfyUI launch tuning (read by scripts/start_comfyui.ps1):
#KREA_COMFY_VRAM_MODE=highvram  # highvram | normalvram | lowvram | novram
#KREA_COMFY_HIGHVRAM=1          # legacy alias for KREA_COMFY_VRAM_MODE=highvram
#KREA_COMFY_RESERVE_VRAM=2.0    # GB headroom so the driver never spills to shared RAM
#KREA_COMFY_SAGE=1              # SageAttention (0 to disable)
#KREA_COMFY_ARGS=               # full override of ALL ComfyUI flags (advanced)

# Paths to downloaded checkpoint files. Leave blank to auto-detect files under models/krea2.
KREA2_TURBO_PATH=
KREA2_RAW_PATH=

# Output directory for generated images
OUTPUT_DIR=outputs

# Auto-load this checkpoint when run.bat starts (leave blank to disable)
KREA2_AUTO_CHECKPOINT=
KREA2_AUTO_QUANT=bf16

# AI helper backend for magic wand/image-to-prompt: local | openrouter | ideogram-json
# local uses the bundled Qwen3-VL support model; OpenRouter/Ideogram are optional hosted helpers.
PROMPT_EXPANDER_BACKEND=local
LOCAL_LLM_BACKEND=comfy
COMFY_QWEN_MODEL=2b
COMFY_QWEN_QUANT=8bit
KREA_COMFY_WARMUP=false
IDEOGRAM_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FREE_ONLY=true

# When true, default run.bat waits for the local /krea server, runs tailscale up,
# starts the /krea Funnel route, then opens the public URL if available.
KREA_SHARE_AUTO_FUNNEL=false
