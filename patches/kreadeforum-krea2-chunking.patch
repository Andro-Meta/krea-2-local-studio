+    @staticmethod
+    def _use_tiled_vae(width, height):
+        return max(int(width), int(height)) >= 1024
+
+    def _encode_pixels(self, vae, image_bhwc, width, height):
+        pixels = image_bhwc[:, :, :, :3]
+        if self._use_tiled_vae(width, height) and hasattr(vae, "encode_tiled"):
+            return vae.encode_tiled(pixels)
+        return vae.encode(pixels)
+
+    def _decode_latents(self, vae, samples, width, height):
+        if self._use_tiled_vae(width, height) and hasattr(vae, "decode_tiled"):
+            return vae.decode_tiled(samples)
+        return vae.decode(samples)
+
+    @staticmethod
+    def _lerp_conditioning(cond_a, cond_b, alpha):
+        alpha = float(min(1.0, max(0.0, alpha)))
+        if alpha <= 0.0:
+            return cond_a
+        if alpha >= 1.0:
+            return cond_b
+        tensor_a, meta_a = cond_a[0]
+        tensor_b, meta_b = cond_b[0]
+        mixed = tensor_a * (1.0 - alpha) + tensor_b * alpha
+        meta = dict(meta_a)
+        pooled_a = meta_a.get("pooled_output")
+        pooled_b = meta_b.get("pooled_output")
+        if pooled_a is not None and pooled_b is not None:
+            meta["pooled_output"] = pooled_a * (1.0 - alpha) + pooled_b * alpha
+        return [[mixed, meta]]
+
+    def _positive_conditioning(self, clip, prompts, frame_index, blend_frames, cache):
+        current = prompts[frame_index]
+        if blend_frames <= 0:
+            if current not in cache:
+                cache[current] = encode_text(clip, current)
+            return cache[current]
+
+        prev_change = 0
+        for index in range(1, frame_index + 1):
+            if prompts[index] != prompts[index - 1]:
+                prev_change = index
+        previous = prompts[prev_change - 1] if prev_change > 0 else current
+        if current not in cache:
+            cache[current] = encode_text(clip, current)
+        if previous not in cache:
+            cache[previous] = encode_text(clip, previous)
+        if prev_change == 0 or previous == current:
+            return cache[current]
+        # Blend across [change, change + blend_frames): alpha goes 1/N .. 1.0
+        if frame_index < prev_change or frame_index >= prev_change + blend_frames:
+            return cache[current]
+        alpha = (frame_index - prev_change + 1) / float(blend_frames)
+        return self._lerp_conditioning(cache[previous], cache[current], alpha)
+
